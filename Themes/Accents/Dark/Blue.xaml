<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Dark family - BLUE accent overlay, the default. PdfCraft's own dark tokens: accent
         4B8BF5, accent text 8CB6FA, selection the deep wash 243657 / 233A63 with accent text. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#233A63" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#243657" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#243657" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#8CB6FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#4B8BF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#4B8BF5" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#233A63" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#8CB6FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#233A63" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#8CB6FA" po:Freeze="True"/>

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AccentLogo"        Color="#4B8BF5" po:Freeze="True"/>
</ResourceDictionary>
