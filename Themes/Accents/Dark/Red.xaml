<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Dark family - RED accent overlay. Overrides only the accent-hue keys; everything
         neutral (and the fixed greens: InstallBtnBg, AccentLogo) comes from Dark.xaml. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#613335" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#593233" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#593233" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#E98D8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#DD504B" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#DD504B" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#613335" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#E98D8A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#613335" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E98D8A" po:Freeze="True"/>

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FooterAccentBrush" Color="#DF5954"/>
    <SolidColorBrush x:Key="AccentLogo"        Color="#DD504B" po:Freeze="True"/>
</ResourceDictionary>
