<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">


    <SolidColorBrush x:Key="PrimaryBrush"        Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#655F1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#5D581E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#5D581E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#F1E659" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#EAD900" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#EAD900" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#655F1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#F1E659" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#655F1D" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F1E659" po:Freeze="True"/>

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#EAD900"/>
    <SolidColorBrush x:Key="AccentLogo"        Color="#EAD900" po:Freeze="True"/>
</ResourceDictionary>
