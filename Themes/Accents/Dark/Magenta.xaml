<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">


    <SolidColorBrush x:Key="PrimaryBrush"        Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#6B345D" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#633257" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#633257" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#FF8FDC" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#FF52C9" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#FF52C9" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#6B345D" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#FF8FDC" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#6B345D" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF8FDC" po:Freeze="True"/>

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AccentLogo"        Color="#FF52C9" po:Freeze="True"/>
</ResourceDictionary>
