<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">


    <SolidColorBrush x:Key="PrimaryBrush"        Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#3D3D3D" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#141414" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#F2C500" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#F2C500" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#E1E1E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#E5E5E5" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#E5E5E5" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#202020" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#F2C500" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#1a1a1a" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#E1E1E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#202020" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#E1E1E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#202020" po:Freeze="True"/>

    <SolidColorBrush x:Key="AccentLogo" Color="#F2C500" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#262626"/>
    <sys:Double x:Key="WordmarkAccentShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.9</sys:Double>
</ResourceDictionary>
