<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Light family - BLUE accent overlay, the default. PdfCraft's own tokens: accent 1B63E0,
         accent text 1755C4, and selection as the soft accent wash E3ECFD / E6EEFD with accent
         text rather than a filled bar. -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#E6EEFD" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#E3ECFD" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#E3ECFD" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#1755C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#1B63E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#1B63E0" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#E6EEFD" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#1755C4" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#E6EEFD" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1755C4" po:Freeze="True"/>

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AccentLogo"        Color="#1B63E0" po:Freeze="True"/>
</ResourceDictionary>
