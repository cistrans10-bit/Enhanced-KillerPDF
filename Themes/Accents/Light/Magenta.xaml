<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">


    <SolidColorBrush x:Key="PrimaryBrush"        Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#F3DBEB" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#F4E0EE" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#F4E0EE" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#8D005F" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"     Color="#A60070" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccentText" Color="#A60070" po:Freeze="True"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#F3DBEB" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#8D005F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#F3DBEB" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#8D005F" po:Freeze="True"/>

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AccentLogo"        Color="#A60070" po:Freeze="True"/>
</ResourceDictionary>
