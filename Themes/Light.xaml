<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Light theme, PdfCraft "workbench" palette: neutral chrome, white panels, one accent and a
         soft gray pasteboard behind the page. Values follow PdfCraft's design tokens
         (crates/ui-egui/src/theme.rs, Light): titlebar E9E9EB, chrome/panel FFFFFF, pasteboard
         F1F1F3, border DADADE, divider E8E8EB, text 222226/5E5E66/6B6B73, icon 44444B, hover F0F0F3,
         pressed E4E4E9. The accent comes from Accents/Light/<Accent>.xaml (Blue by default). -->
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"       Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"   Color="#F0F0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"  Color="#F0F0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"  Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgFlyout"       Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="AnnotationBarBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFieldBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboFieldBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboFieldHoverBrush" Color="#F0F0F3" po:Freeze="True"/>
    <LinearGradientBrush x:Key="TabStripFadeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0" Color="#00000000"/>
        <GradientStop Offset="1.0" Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryBrush"    Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"  Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush" Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"     Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="InstallBtnBg"   Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="DropBorder"     Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush" Color="#E8E8EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush"  Color="#DADADE" po:Freeze="True"/>
    <!-- Selection is a soft accent wash with accent text, as in PdfCraft (accent_soft). -->
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#E3F2E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#E3F2E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#E3F2E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#166A3B" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg" Color="#F0F0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBrush"      Color="#222226" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5E5E66" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"  Color="#44444B" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#44444B" po:Freeze="True"/>
    <SolidColorBrush x:Key="FilenameBrush"  Color="#222226" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"   Color="#6B6B73" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"     Color="#6B6B73" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"      Color="#E03E3E" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgDragHandle"   Color="#B8B8C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="DragLine"       Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#C4C4CA" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9E9EA6" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#F7F7F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowAltBrush"      Color="#08000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"  Color="#B8B8C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeLineBrush"    Color="#E8E8EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"    Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"    Color="#1b7a45" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgOverlay"      Color="#66000000" po:Freeze="True"/>
    <!-- Flat, crisp surfaces: no film grain, no glyph shadows. -->
    <sys:Double x:Key="GrainOpacity">0</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0</sys:Double>
    <sys:Double x:Key="HeaderShadowOpacity">0</sys:Double>

    <!-- The pasteboard behind the page. -->
    <SolidColorBrush x:Key="BgCanvas"                                                       Color="#F1F1F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#E3F2E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#166A3B" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#E3F2E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#166A3B" po:Freeze="True"/>

    <!-- Shortcut keyboard view: category colors, PdfCraft's tool hues. -->
    <SolidColorBrush x:Key="KsCatFile"      Color="#3A6FE8" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatTools"     Color="#E88A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatEdit"      Color="#D63B8F" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatNav"       Color="#8E4EE6" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatView"      Color="#149CA8" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatSearch"    Color="#3A6FE8" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatHelp"      Color="#2D9D5B" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatOcr"       Color="#E03E3E" po:Freeze="True"/>

    <DropShadowEffect x:Key="TextStroke" Color="Black" BlurRadius="2" ShadowDepth="0.5" Direction="270" Opacity="0.2"/>

    <!-- PdfCraft's radius is 6 for controls; flyouts and cards round a little more. The
         document pane is flush with the chrome around it, so its corners are square. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="FlyoutCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TabCornerRadius">6,6,0,0</CornerRadius>

    <SolidColorBrush x:Key="OutlineRestBrush" Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionButtonBorderBrush" Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#222226"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#FFFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FFF0F0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#FFFFFFFF" po:Freeze="True"/>
    <!-- The tab strip at the very top is the one gray band; everything under it is white. -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFE9E9EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarPaneBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarRailBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneEdgeBrush" Color="#E8E8EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="BarEdgeBrush" Color="#E8E8EB" po:Freeze="True"/>

    <!-- PdfCraft shell roles (Shell/CraftShell.cs, MainWindow.xaml). -->
    <SolidColorBrush x:Key="CraftChromeBrush"     Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftDividerBrush"    Color="#E8E8EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftBorderBrush"     Color="#DADADE" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftIconBrush"       Color="#44444B" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftFaintBrush"      Color="#6B6B73" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftHoverBrush"      Color="#F0F0F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftPressedBrush"    Color="#E4E4E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftTabBrush"        Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftTitleHoverBrush" Color="#DCDCE0" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftFieldBrush"      Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftCardBrush"       Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftPaletteShadow"   Color="#22000000" po:Freeze="True"/>

    <sys:Double x:Key="TitleBarHeight">42</sys:Double>
    <sys:Double x:Key="CaptionButtonHeight">42</sys:Double>
    <sys:Double x:Key="TitleWordmarkSize">15</sys:Double>
    <sys:Double x:Key="TitleWordmarkBoldSize">22.52</sys:Double>
    <sys:Double x:Key="TitleIconSize">18</sys:Double>
    <sys:Double x:Key="FileNameFontSize">13.5</sys:Double>
    <sys:Double x:Key="MenuFontSize">13</sys:Double>
    <sys:Double x:Key="FooterTextSize">12</sys:Double>
    <sys:Double x:Key="DocPaneInset">0</sys:Double>
    <sys:Double x:Key="WordmarkShadowOpacity">0</sys:Double>
    <sys:Double x:Key="PaneShadowOpacity">0</sys:Double>
    <sys:Double x:Key="BarShadowOpacity">0</sys:Double>
    <sys:Double x:Key="FlyoutShadowOpacity">0.16</sys:Double>
    <sys:Double x:Key="ThemeRadioShadowOpacity">0</sys:Double>
    <sys:Double x:Key="ShortcutHeaderShadowOpacity">0</sys:Double>
    <sys:Double x:Key="AboutIconShadowOpacity">0.2</sys:Double>
    <Visibility x:Key="WordmarkVisibility">Collapsed</Visibility>
    <Visibility x:Key="FooterVersionDividerVisibility">Collapsed</Visibility>
    <Thickness x:Key="SplitHostMargin">0</Thickness>
    <Thickness x:Key="CraftPanelEdge">0</Thickness>
    <Thickness x:Key="ContentPaneMargin">0</Thickness>
    <Thickness x:Key="TitleLogoMargin">10,0,4,0</Thickness>
    <Thickness x:Key="TitleIconMargin">0</Thickness>
    <Thickness x:Key="FooterPadding">12,0,8,0</Thickness>
    <Thickness x:Key="MenuItemPadding">10,7,12,7</Thickness>
    <Thickness x:Key="TabPadding">12,4,6,5</Thickness>
    <sys:Double x:Key="FooterHeight">28</sys:Double>
    <sys:Double x:Key="ScrollBarThickness">10</sys:Double>
    <CornerRadius x:Key="ScrollThumbRadius">4</CornerRadius>
    <TranslateTransform x:Key="FileNameTransform" X="0" Y="0"/>
</ResourceDictionary>
