<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- KillerTools dark/green theme (macOS-style palette) -->
    <SolidColorBrush x:Key="BgDark"         Color="#1e1e1e" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#2c2c2e" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgHover"        Color="#3a3a3c" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgSidebar"      Color="#1c1c1e" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"  Color="#262626" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgFlyout"       Color="#262626" po:Freeze="True"/>
    <LinearGradientBrush x:Key="TabStripFadeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0" Color="#00000000"/>
        <GradientStop Offset="0.55" Color="#1f000000"/>
        <GradientStop Offset="1.0" Color="#82000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgModal"        Color="#2c2c2e" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderDim"      Color="#38383a" po:Freeze="True"/>
    <SolidColorBrush x:Key="Accent"         Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderAccent"   Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"     Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="InstallBtnBg"   Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBorder"   Color="#48484a" po:Freeze="True"/>
    <SolidColorBrush x:Key="DropBorder"     Color="#3a3a3c" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorder"     Color="#38383a" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDim"      Color="#103a20" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#1f6b3a" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#ffffff" po:Freeze="True"/>
    <!-- Background of an open settings row. Solid hover tint here; the RGB themes override it with their
         translucent-white SelectionBg so the accent row text reads on it like a selected page/tool. -->
    <SolidColorBrush x:Key="SettingsOpenRowBg" Color="#3a3a3c" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#f5f5f7" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#98989d" po:Freeze="True"/>
    <SolidColorBrush x:Key="FilenameBrush"  Color="#98989d" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextDim"        Color="#6e6e73" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"     Color="#6e6e73" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"      Color="#ff453a" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgDragHandle"   Color="#636366" po:Freeze="True"/>
    <SolidColorBrush x:Key="DragLine"       Color="#48484a" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgScrollThumb"  Color="#5532d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"    Color="#48484a" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"    Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgOverlay"      Color="#BB000000" po:Freeze="True"/>
    <sys:Double x:Key="GrainOpacity">0.12</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0.45</sys:Double>
    <sys:Double x:Key="HeaderShadowOpacity">0.2</sys:Double>

    <SolidColorBrush x:Key="BgCanvas"                                                       Color="#2c2c2e" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#103a20" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#32d74b" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#103a20" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#32d74b" po:Freeze="True"/>

</ResourceDictionary>
