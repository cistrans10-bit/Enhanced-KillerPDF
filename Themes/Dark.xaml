<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark theme, PdfCraft "workbench" palette (Dark Gray): the chrome goes dark, the pasteboard
         goes darker still, and the pages themselves stay white. Values follow PdfCraft's design
         tokens (crates/ui-egui/src/theme.rs, Dark): titlebar 1B1B1E, chrome/panel 26262A,
         pasteboard 19191C, card 2E2E33, border 3C3C43, divider 333339, text ECECEF/AEAEB6/97979E,
         icon D4D4DA, hover 34343A, pressed 3E3E45. The accent comes from
         Accents/Dark/<Accent>.xaml (Blue by default). -->
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"       Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"   Color="#34343A" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"  Color="#34343A" po:Freeze="True"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"  Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgFlyout"       Color="#2E2E33" po:Freeze="True"/>
    <SolidColorBrush x:Key="AnnotationBarBrush" Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFieldBrush" Color="#1E1E22" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboFieldBrush" Color="#1E1E22" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboFieldHoverBrush" Color="#34343A" po:Freeze="True"/>
    <LinearGradientBrush x:Key="TabStripFadeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0" Color="#00000000"/>
        <GradientStop Offset="1.0" Color="#00000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2E2E33" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryBrush"    Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"  Color="#0a0a0a" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush" Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"     Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="InstallBtnBg"   Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="DropBorder"     Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush" Color="#333339" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush"  Color="#3C3C43" po:Freeze="True"/>
    <!-- Selection is a soft accent wash with accent text, as in PdfCraft (accent_soft). -->
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#173826" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#173826" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#173826" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#6FD39A" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg" Color="#34343A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextBrush"      Color="#ECECEF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#AEAEB6" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"  Color="#D4D4DA" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#D4D4DA" po:Freeze="True"/>
    <SolidColorBrush x:Key="FilenameBrush"  Color="#ECECEF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"   Color="#97979E" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"     Color="#97979E" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"      Color="#EF5B5B" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgDragHandle"   Color="#5A5A62" po:Freeze="True"/>
    <SolidColorBrush x:Key="DragLine"       Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#4A4A52" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6A6A73" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#2E2E33" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowAltBrush"      Color="#0CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"  Color="#5A5A62" po:Freeze="True"/>
    <SolidColorBrush x:Key="TreeLineBrush"    Color="#333339" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"    Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"    Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgOverlay"      Color="#99000000" po:Freeze="True"/>
    <!-- Flat, crisp surfaces: no film grain, no glyph shadows. -->
    <sys:Double x:Key="GrainOpacity">0</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0</sys:Double>
    <sys:Double x:Key="HeaderShadowOpacity">0</sys:Double>

    <!-- The pasteboard behind the page: darker than the chrome; pages stay white. -->
    <SolidColorBrush x:Key="BgCanvas"                                                       Color="#19191C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#173826" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#6FD39A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#173826" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#6FD39A" po:Freeze="True"/>

    <!-- Shortcut keyboard view: category colors, PdfCraft's tool hues. -->
    <SolidColorBrush x:Key="KsCatFile"      Color="#3A6FE8" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatTools"     Color="#E88A1A" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatEdit"      Color="#D63B8F" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatNav"       Color="#8E4EE6" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatView"      Color="#149CA8" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatSearch"    Color="#3A6FE8" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatHelp"      Color="#2D9D5B" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatOcr"       Color="#E03E3E" po:Freeze="True"/>

    <DropShadowEffect x:Key="TextStroke" Color="Black" BlurRadius="2" ShadowDepth="0.5" Direction="270" Opacity="0.6"/>

    <!-- PdfCraft's radius is 6 for controls; flyouts and cards round a little more. The
         document pane is flush with the chrome around it, so its corners are square. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="FlyoutCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TabCornerRadius">6,6,0,0</CornerRadius>

    <SolidColorBrush x:Key="OutlineRestBrush" Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionButtonBorderBrush" Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#ECECEF"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#FF26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF34343A" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#FF26262A" po:Freeze="True"/>
    <!-- The tab strip at the very top is the darkest band; the chrome under it is one step up. -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF1B1B1E" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarPaneBrush" Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarRailBrush" Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneEdgeBrush" Color="#333339" po:Freeze="True"/>
    <SolidColorBrush x:Key="BarEdgeBrush" Color="#333339" po:Freeze="True"/>

    <!-- PdfCraft shell roles (Shell/CraftShell.cs, MainWindow.xaml). -->
    <SolidColorBrush x:Key="CraftChromeBrush"     Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftDividerBrush"    Color="#333339" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftBorderBrush"     Color="#3C3C43" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftIconBrush"       Color="#D4D4DA" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftFaintBrush"      Color="#97979E" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftHoverBrush"      Color="#34343A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftPressedBrush"    Color="#3E3E45" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftTabBrush"        Color="#26262A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftTitleHoverBrush" Color="#2C2C31" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftFieldBrush"      Color="#1E1E22" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftCardBrush"       Color="#2E2E33" po:Freeze="True"/>
    <SolidColorBrush x:Key="CraftPaletteShadow"   Color="#66000000" po:Freeze="True"/>

    <sys:Double x:Key="TitleBarHeight">42</sys:Double>
    <sys:Double x:Key="CaptionButtonHeight">42</sys:Double>
    <sys:Double x:Key="TitleWordmarkSize">15</sys:Double>
    <sys:Double x:Key="TitleWordmarkBoldSize">22.52</sys:Double>
    <sys:Double x:Key="TitleIconSize">18</sys:Double>
    <sys:Double x:Key="FileNameFontSize">13.5</sys:Double>
    <sys:Double x:Key="MenuFontSize">13</sys:Double>
    <sys:Double x:Key="FooterTextSize">12</sys:Double>
    <sys:Double x:Key="DocPaneInset">0</sys:Double>
    <sys:Double x:Key="WordmarkShadowOpacity">0</sys:Double>
    <sys:Double x:Key="PaneShadowOpacity">0</sys:Double>
    <sys:Double x:Key="BarShadowOpacity">0</sys:Double>
    <sys:Double x:Key="FlyoutShadowOpacity">0.45</sys:Double>
    <sys:Double x:Key="ThemeRadioShadowOpacity">0</sys:Double>
    <sys:Double x:Key="ShortcutHeaderShadowOpacity">0</sys:Double>
    <sys:Double x:Key="AboutIconShadowOpacity">0.2</sys:Double>
    <Visibility x:Key="WordmarkVisibility">Collapsed</Visibility>
    <Visibility x:Key="FooterVersionDividerVisibility">Collapsed</Visibility>
    <Thickness x:Key="SplitHostMargin">0</Thickness>
    <Thickness x:Key="CraftPanelEdge">0</Thickness>
    <Thickness x:Key="ContentPaneMargin">0</Thickness>
    <Thickness x:Key="TitleLogoMargin">10,0,4,0</Thickness>
    <Thickness x:Key="TitleIconMargin">0</Thickness>
    <Thickness x:Key="FooterPadding">12,0,8,0</Thickness>
    <Thickness x:Key="MenuItemPadding">10,7,12,7</Thickness>
    <Thickness x:Key="TabPadding">12,4,6,5</Thickness>
    <sys:Double x:Key="FooterHeight">28</sys:Double>
    <sys:Double x:Key="ScrollBarThickness">10</sys:Double>
    <CornerRadius x:Key="ScrollThumbRadius">4</CornerRadius>
    <TranslateTransform x:Key="FileNameTransform" X="0" Y="0"/>
</ResourceDictionary>
