<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hand-authored thin outline icons (own geometry, not from any third-party icon set) used for the
         most visible toolbar tools and title-bar controls, in place of the Segoe Fluent glyph font, for a
         more macOS/SF-Symbols-style silhouette. Everything else (menus, dialogs, overflow items) keeps
         the Fluent glyphs. Coordinates are on a loose ~20x20 grid; Path.Stretch=Uniform (set by
         OutlineIconPath below) normalizes actual on-screen size, so the grid doesn't need to be exact. -->

    <PathGeometry x:Key="IconNew" Figures="M6,2 L13,2 L17,6 L17,18 L6,18 Z M13,2 L13,6 L17,6"/>
    <PathGeometry x:Key="IconOpen" Figures="M2,5 L8,5 L10,7 L18,7 L18,16 L2,16 Z"/>
    <PathGeometry x:Key="IconSave" Figures="M10,3 L10,13 M6,9 L10,13 L14,9 M4,17 L16,17"/>
    <PathGeometry x:Key="IconPrint" Figures="M5,3 L15,3 L15,8 M3,8 L17,8 L17,14 L14,14 M3,14 L3,8 M6,12 L14,12 L14,18 L6,18 Z"/>
    <PathGeometry x:Key="IconSelect" Figures="M4,2 L4,17 L8,13 L11,19 L13,18 L10,12 L16,12 Z"/>
    <PathGeometry x:Key="IconText" Figures="M4,5 L16,5 M4,10 L16,10 M4,15 L11,15"/>
    <PathGeometry x:Key="IconHighlight" Figures="M6,14 L14,6 L17,9 L9,17 Z M4,18 L10,18"/>
    <PathGeometry x:Key="IconDraw" Figures="M4,16 L4,19 L7,19 L17,9 L14,6 Z M12,8 L15,11"/>
    <PathGeometry x:Key="IconImage" Figures="M3,4 L17,4 L17,16 L3,16 Z M6,7 A1,1 0 1 1 5.999,7 M3,14 L8,9 L11,12 L14,9 L17,13"/>
    <PathGeometry x:Key="IconSignature" Figures="M3,15 C5,9 7,17 9,11 C11,5 13,15 15,9 C16,7 17,8 17,8"/>
    <PathGeometry x:Key="IconCrop" Figures="M6,2 L6,14 L18,14 M2,6 L14,6 L14,18"/>
    <PathGeometry x:Key="IconRotate" Figures="M15,5 A6,6 0 1 0 16,10 M15,5 L18,5 L16,8"/>
    <PathGeometry x:Key="IconStamp" Figures="M6,14 L14,14 L15,18 L5,18 Z M10,3 L10,11 M7,11 L13,11 M7,6 L13,6"/>
    <PathGeometry x:Key="IconSidebar" Figures="M3,3 L17,3 L17,17 L3,17 Z M8,3 L8,17"/>
    <PathGeometry x:Key="IconChevronLeft" Figures="M12,4 L6,10 L12,16"/>
    <PathGeometry x:Key="IconChevronRight" Figures="M8,4 L14,10 L8,16"/>
    <PathGeometry x:Key="IconSearch" Figures="M9,4 A5,5 0 1 0 9.001,4 M13,13 L18,18"/>
    <PathGeometry x:Key="IconZoomIn" Figures="M9,4 A5,5 0 1 0 9.001,4 M13,13 L18,18 M9,6 L9,12 M6,9 L12,9"/>
    <PathGeometry x:Key="IconZoomOut" Figures="M9,4 A5,5 0 1 0 9.001,4 M13,13 L18,18 M6,9 L12,9"/>
    <PathGeometry x:Key="IconUndo" Figures="M8,5 L3,9 L8,13 M3,9 L13,9 A5,5 0 0 1 13,19"/>
    <PathGeometry x:Key="IconTrash" Figures="M4,6 L16,6 M8,6 L8,4 L12,4 L12,6 M6,6 L7,18 L13,18 L14,6"/>
    <PathGeometry x:Key="IconMinimize" Figures="M5,15 L15,15"/>
    <PathGeometry x:Key="IconMaximize" Figures="M6,6 L15,6 L15,15 L6,15 Z"/>
    <PathGeometry x:Key="IconClose" Figures="M6,6 L14,14 M14,6 L6,14"/>

    <!-- Shared stroke style: Stroke tracks the hosting Button's Foreground so hover/selected/danger/accent
         color states (set by the button's own Style triggers or by code-behind for the active tool) keep
         working exactly as they did with the glyph font - only the shape changes. -->
    <Style x:Key="OutlineIconPath" TargetType="Path">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Standard 17x17 icon slot, matching the toolbar glyphs' visual weight/size. -->
    <Style x:Key="OutlineIconViewbox" TargetType="Viewbox">
        <Setter Property="Width" Value="17"/>
        <Setter Property="Height" Value="17"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

</ResourceDictionary>
